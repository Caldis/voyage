  {"name": "tw-storm-side", "p": {"preset": "wpac", "date": "2026-09-28", "time": 900, "coverage": 0.3, "weather": "storm", "wing-pos": "-4"}, "js": "const H=127; v.director.setHeading(H); v.state.heading=H; v.state.bankDeg=0; const w=document.getElementById('weather'); w.dispatchEvent(new Event('change')); return 'heading '+v.state.heading+' storms '+v.weather.storms.length;"}
