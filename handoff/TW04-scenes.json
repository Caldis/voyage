  {"name": "tw-squall", "p": {"preset": "wpac", "date": "2026-09-28", "time": 900, "coverage": 0.3, "weather": "squall", "wing-pos": "-4"}, "js": "const R=[4.6,5.8,4.2,5.2],T=[12.4,13.9,11.8,13.1]; v.weather.storms.forEach((s,i)=>{s.radius=R[i];s.top=T[i];}); v.weather.syncUniforms(); return v.weather.storms.map(s=>s.top).join(',');"},
  {"name": "tw-storm-far150", "p": {"preset": "wpac", "date": "2026-09-28", "time": 900, "coverage": 0.3, "weather": "storm", "wing-pos": "-4"}, "js": "const o=v.cloudUniforms.uCloudOffset.value; v.weather.storms.forEach(s=>{s.x=o.x+(s.x-o.x)*2.5;s.z=o.y+(s.z-o.y)*2.5;}); v.weather.syncUniforms(); return v.weather.storms.map(s=>Math.hypot(s.x-o.x,s.z-o.y).toFixed(0)).join(',')+' km';"},
  {"name": "tw-storm-far250", "p": {"preset": "wpac", "date": "2026-09-28", "time": 900, "coverage": 0.3, "weather": "storm", "wing-pos": "-4"}, "js": "const o=v.cloudUniforms.uCloudOffset.value; v.weather.storms.forEach(s=>{s.x=o.x+(s.x-o.x)*4.2;s.z=o.y+(s.z-o.y)*4.2;}); v.weather.syncUniforms(); return v.weather.storms.map(s=>Math.hypot(s.x-o.x,s.z-o.y).toFixed(0)).join(',')+' km';"},
  {"name": "tw-storm-near", "p": {"preset": "wpac", "date": "2026-09-28", "time": 900, "coverage": 0.3, "weather": "storm", "wing-pos": "-4"}, "js": "const o=v.cloudUniforms.uCloudOffset.value; v.weather.storms.forEach(s=>{s.x=o.x+(s.x-o.x)*0.55;s.z=o.y+(s.z-o.y)*0.55;}); v.weather.syncUniforms(); return v.weather.storms.map(s=>Math.hypot(s.x-o.x,s.z-o.y).toFixed(0)).join(',')+' km';"},
