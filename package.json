{
  "name": "voyage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "航行伴侣：模拟从交通工具窗口看出去的风景，物理大气 + 真实太阳位置",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:glsl": "node scripts/lint-shaders.mjs",
    "shots": "node scripts/dev-browser.mjs shots",
    "cold": "node scripts/dev-browser.mjs cold",
    "bench": "node scripts/dev-browser.mjs bench",
    "flicker": "node scripts/dev-browser.mjs flicker",
    "probe": "node scripts/probe.mjs",
    "passes": "node scripts/passes.mjs",
    "shader-budget": "node scripts/shader-budget.mjs",
    "shader-parity": "node scripts/shader-parity.mjs",
    "weather-stats": "node --experimental-transform-types --no-warnings scripts/weather-stats.mts",
    "check-routes": "node --import ./scripts/lib/ts-resolve.mjs --experimental-transform-types --no-warnings scripts/check-routes.mts"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "astronomy-engine": "^2.1.19",
    "pbf": "^5.1.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "glslang-validator-prebuilt-predownloaded": "^0.0.2",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
